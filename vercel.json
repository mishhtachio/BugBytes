{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server",
        "path": "/api/$1"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server",
        "path": "/api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app",
        "path": "/$1"
      }
    }
  ]
}
