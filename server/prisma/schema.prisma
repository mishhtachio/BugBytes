datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  LEAD
  DEVELOPER
  DESIGNER
  QA
  PRODUCT_MANAGER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueType {
  ISSUE
  BUG
  FEATURE
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  avatar    String?
  username  String?  @unique
  createdAt DateTime @default(now())

  // Workspace ownership
  createdWorkspaces Workspace[] @relation("CreatedWorkspaces")

  // Project ownership
  createdProjects Project[] @relation("CreatedProjects")

  // Memberships
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  // Issues
  assignedIssues Issue[] @relation("AssignedIssues")
  createdIssues  Issue[] @relation("CreatedIssues")

  // Comments
  comments Comment[]

  // Personal workspace
  personalTodos PersonalTodo[]

  // Notifications
  notifications Notification[]

  // Activity feed
  activities ProjectActivity[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isPublic  Boolean  @default(false)

  creatorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("CreatedWorkspaces", fields: [creatorId], references: [id])

  members WorkspaceMember[]
  projects Project[]
  invitations ProjectInvitation[]
  issues Issue[]
}

model WorkspaceMember {
  id Int @id @default(autoincrement())

  workspaceId String
  userId      String

  role WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Project {
  id String @id @default(uuid())

  workspaceId String
  creatorId   String

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator User @relation("CreatedProjects", fields: [creatorId], references: [id])

  members ProjectMember[]
  invitations ProjectInvitation[]
  issues Issue[]
  personalTodos PersonalTodo[]
  activities ProjectActivity[]
}

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId String
  userId    String

  role ProjectRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectInvitation {
  id String @id @default(uuid())

  projectId   String
  workspaceId String

  email String

  invitedBy String

  role ProjectRole
  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Issue {
  id String @id @default(cuid())

  issueNumber Int

  workspaceId String
  projectId   String

  title       String
  description String @default("")

  status   IssueStatus   @default(TODO)
  priority IssuePriority @default(MEDIUM)
  type     IssueType     @default(ISSUE)

  assigneeId String?
  creatorId  String

  // Bug metadata
  bugSeverity String?
  bugEnv      String?

  // Feature metadata
  featureScope String?
  storyPoints  Int?

  tags String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User? @relation("AssignedIssues", fields: [assigneeId], references: [id])
  creator User @relation("CreatedIssues", fields: [creatorId], references: [id])

  comments Comment[]

  @@unique([projectId, issueNumber])

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
}

model Comment {
  id String @id @default(uuid())

  issueId String
  userId  String

  content String

  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model PersonalTodo {
  id String @id @default(uuid())

  projectId String
  userId    String

  text String

  completed Boolean @default(false)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectActivity {
  id String @id @default(uuid())

  projectId String

  userId String?

  userName String
  message  String

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([projectId])
}

model Notification {
  id String @id @default(uuid())

  userId String

  title   String
  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}
